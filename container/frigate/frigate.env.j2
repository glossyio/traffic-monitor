# Frigate environment variables
FRIGATE_RTSP_PASSWORD={{ tmsetup_frigate_rtsp_password }}
# Credentials Frigate uses to read the camera from go2rtc on the host (set by tmsetup.sh)
FRIGATE_GO2RTC_RTSP_USER={{ tmsetup_go2rtc_rtsp_user }}
FRIGATE_GO2RTC_RTSP_PASSWORD={{ tmsetup_secrets['go2rtc_rtsp_password'] }}
# Frigate trusts the reverse proxy's user and role headers only with this secret (set by tmsetup.sh)
FRIGATE_PROXY_AUTH_SECRET={{ tmsetup_secrets['frigate_proxy_secret'] }}
PLUS_API_KEY=
FRIGATE_MQTT_USER={{ tmsetup_mqtt_broker_login.username or tmsetup_frigate_mqtt_user }}
FRIGATE_MQTT_PASSWORD={{ tmsetup_mqtt_broker_login.password or tmsetup_frigate_mqtt_password }}
FRIGATE_HOME_DIR={{ tmsetup_codedir }}/frigate
FRIGATE_VERSION={{ tmsetup_frigate_version }}
# Keep in step with the /frigate location in revproxy's frigate.conf.j2 and the path in tm-control's APPS
FRIGATE_BASE_PATH=/frigate
