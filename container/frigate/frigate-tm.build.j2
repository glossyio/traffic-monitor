[Unit]
Description=Build of Traffic Monitor Frigate image

[Build]
SetWorkingDirectory={{ tmsetup_codedir }}/frigate
File=Containerfile
Pull=newer
ImageTag=localhost/frigate-tm:{{ tmsetup_frigate_version }}

[Service]
# Takes Podman's first-command crash after a power loss, so the build doesn't (#268). "-" ignores its result.
ExecStartPre=-{{ tmsetup_podman_refresh_command }}
