user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /run/nginx.pid;


events {
    worker_connections  1024;
}


http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;

    #gzip  on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # The sign-in window. On its hotspot the unit answers every name (dnsmasq), so a phone's connection test arrives
    # here with a foreign Host; the redirect is what makes the phone open its sign-in window on the control app.
    # Only for requests that arrived on the hotspot address. Never answer such a test with success: an Android 17
    # phone has no other way in.
    map "$server_addr $host" $tm_sign_in {
        default 0;
        "~^{{ tmsetup_hotspot_address | regex_escape }} (?!({{ tmsetup_hotspot_address | regex_escape }}|{{ ansible_facts['hostname'] | lower | regex_escape }}(\.local)?)$)" 1;
    }
    # Tells tm-control's API that the request came over the hotspot (empty: no header is sent)
    map $server_addr $tm_on_hotspot {
        default "";
        {{ tmsetup_hotspot_address }} 1;
    }

    server {
        if ($tm_sign_in) { return 302 http://{{ tmsetup_hotspot_address }}/; }

        listen 80 default_server;
        server_name _;  # This will match any hostname
        # Relative Location headers (login and trailing-slash redirects), so they keep the host and
        # port the browser used, such as a port-forward or an SSH tunnel, rather than port 80
        absolute_redirect off;

        #Logs for Nginx access and errors
        access_log /var/log/nginx/access.log;
        error_log /var/log/nginx/error.log;

        # One file per app, and tm-control's own (its UI serves /), listed in tmsetup_revproxy_locations
        include /etc/nginx/tm/locations/*.conf;
    }
}
