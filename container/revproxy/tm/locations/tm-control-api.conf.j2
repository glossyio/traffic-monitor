# tm-control's API and logout. No auth snippet: tm-control checks the session on each call itself.
location /api/ {
    proxy_pass http://127.0.0.1:{{ tmsetup_tm_control_port }}/api/;
    include /etc/nginx/tm/snippets/proxy-common.conf;
    proxy_buffering off;
    # Only nginx's /_auth locations name a required role, and tm-control's verify answers nothing without one
    proxy_set_header X-TM-Required-Role "";
}
# Only nginx's internal /_auth locations may call verify. A prefix match, not =: nginx decodes
# /api/v1/auth/verify%0A to a trailing newline, which would miss an exact match and reach /api/.
location ^~ /api/v1/auth/verify { return 404; }
location = /logout {
    proxy_pass http://127.0.0.1:{{ tmsetup_tm_control_port }}/logout;
    include /etc/nginx/tm/snippets/proxy-common.conf;
}
