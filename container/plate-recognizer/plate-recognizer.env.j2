# Plate Recognizer settings, loaded by plate-recognizer.service.
# TOKEN and LICENSE_KEY come from the device's secrets directory, and tmsetup.sh rewrites them on every run:
# set them on the control app's Device page, not here. Blank means not set.
TOKEN={{ tmsetup_secrets['plate_recognizer_token'] }}
LICENSE_KEY={{ tmsetup_secrets['plate_recognizer_license_key'] }}
WORKERS=2
