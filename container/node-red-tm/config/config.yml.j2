thingsboard:
    # The access token isn't kept in this file. Set it on the control app's Device page.
    enabled: false
    host: {{ tmsetup_thingsboard_server }}
    protocol: {{ tmsetup_thingsboard_protocol }}
    # port: {{ tmsetup_thingsboard_port }}

deployment:
    lat: {{ tmsetup_latitude }}
    lon: {{ tmsetup_longitude }}
    bearing: '{{ tmsetup_bearing }}'
    survey_id:  # names the place the device is used at (see the setup guide); a change here starts a new deployment
    database_precision: '2'  # none, 1, or 2 decimal places stored in the database

sensors:
    cameras:
        picam_h265:
            enabled: true
            camera_radar: TM_RADAR_SERIAL_PORT_00

    radars:
        TM_RADAR_SERIAL_PORT_00:
            enabled: true
            opt_api_commands_array: '["^/+0.00\n", "^/-0.00\n"]'

    airquality_monitors:
        sensorname01:
            enabled: false
            mqtt_topic_incoming: readings
