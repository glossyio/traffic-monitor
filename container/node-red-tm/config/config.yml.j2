thingsboard:
    # The access token isn't kept in this file. Set it, and choose what's shared, on the control app's Sharing page.
    enabled: false
    host: {{ tmsetup_thingsboard_server }}
    protocol: {{ tmsetup_thingsboard_protocol }}
    # port: {{ tmsetup_thingsboard_port }}

deployment:
    lat: {{ tmsetup_latitude }}
    lon: {{ tmsetup_longitude }}
    heading_deg: {{ tmsetup_heading_deg }}
    survey_id:  # names the place the device is used at (set on the control app's Location page); a change here starts a new deployment
    database_precision: '2'  # none, 1, or 2 decimal places stored in the database
    timezone:  # the place's time zone, set on the control app's Location page; an edit here is put back

sensors:
    cameras:
        picam_h265:
            enabled: true
            camera_radar: TM_RADAR_SERIAL_PORT_00

    radars:
        TM_RADAR_SERIAL_PORT_00:
            enabled: true
            opt_api_commands_array: '[]'

    airquality_monitors:
        sensorname01:
            enabled: false
            mqtt_topic_incoming: readings
