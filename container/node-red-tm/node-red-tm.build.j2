[Unit]
Description=Build of Traffic Monitor Node Red image

[Build]
SetWorkingDirectory={{ tmsetup_codedir }}/node-red-tm
File=Containerfile
Pull=newer
ImageTag=localhost/node-red-tm:latest

[Service]
# Takes Podman's first-command crash after a power loss, so the build doesn't (#268). "-" ignores its result.
ExecStartPre=-{{ tmsetup_podman_refresh_command }}
