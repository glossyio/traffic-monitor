# /etc/systemd/system/tm-job-set-secret.service, installed by tmsetup.sh (tm-control tag)
# A static root job, never enabled: tm-control starts it through polkit
# (/etc/polkit-1/rules.d/50-traffic-monitor.rules) after writing the request /run/tm-control/jobs/set-secret.json.
# The script checks the request, writes the entered secret's file in the secrets directory and its lines in the apps'
# env files, restarts the apps that read them, and deletes the request.

[Unit]
Description=Traffic Monitor job: set an entered secret
# A start refused by the start limit would leave the job queued in tm-control
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=TM_CONTROL_MANIFEST={{ tmsetup_etc_dir }}/manifest.json
Environment=TM_CONTROL_SECRETS_DIR={{ tmsetup_secrets_dir }}
ExecStart={{ tmsetup_tm_control_dir }}/venv/bin/python -EP {{ tmsetup_libexec_dir }}/tm-job-set-secret
