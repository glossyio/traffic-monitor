# /etc/systemd/system/tm-control.service, installed by tmsetup.sh (tm-control tag)
# Runs unprivileged as the code owner. It starts units, sets the time, and reboots or powers off only through polkit
# (/etc/polkit-1/rules.d/50-traffic-monitor.rules), and writes only its state and runtime directories.
# systemd-journal: a finished job unit is unloaded, so tm-control reads PID 1's job-end entries from the journal for
# the job's result, and diagnostics includes the units' journals. video: vcgencmd get_throttled, for the power and
# throttling check, opens /dev/vcio_gencmd, which is root:video.

[Unit]
Description=Traffic Monitor control app (tm-control)
After=network.target

[Service]
User={{ tmsetup_codeowner }}
Group={{ tmsetup_codegroup }}
SupplementaryGroups=systemd-journal video
ExecStart=/usr/local/bin/tm-control serve
Environment=TM_CONTROL_SECRETS_DIR={{ tmsetup_secrets_dir }}
Environment=TM_CONTROL_MANIFEST={{ tmsetup_etc_dir }}/manifest.json
Environment=TM_CONTROL_BIND=127.0.0.1:{{ tmsetup_tm_control_port }}
StateDirectory=tm-control
StateDirectoryMode=0700
RuntimeDirectory=tm-control
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
