# /etc/systemd/system/tm-job-system-password.service, installed by tmsetup.sh (tm-control tag)
# A static root job, never enabled: tm-control starts it through polkit
# (/etc/polkit-1/rules.d/50-traffic-monitor.rules) after writing the request /run/tm-control/jobs/system-password.json.
# The script checks the request, sets the manifest's installing user's password, and deletes the request.

[Unit]
Description=Traffic Monitor job: set the installing user's password
# A start refused by the start limit would leave the job queued in tm-control
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=TM_CONTROL_MANIFEST={{ tmsetup_etc_dir }}/manifest.json
ExecStart={{ tmsetup_tm_control_dir }}/venv/bin/python -EP {{ tmsetup_libexec_dir }}/tm-job-system-password
