#!/usr/bin/python3
"""Keep the Wi-Fi radio on a known network or on the hotspot.

A systemd timer runs this as root (`python -EP`) every five minutes. It prints one line, the outcome, and exits 0. It
exits 1, with one sentence on stderr, when the hotspot profile is missing or nmcli can't be run. It reads
TM_WIFI_DEVICE (default wlan0), TM_HOTSPOT_PROFILE (default tm-hotspot), and TM_NETWORK_STATE (default
/run/traffic-monitor/network-retry.json). No password is read or printed: nothing here asks nmcli for secrets.
One run, in order; the first step that applies ends it, with that outcome:
1. The device has no wireless directory under /sys/class/net: `no-radio`. It is a USB adapter: `usb-radio`.
2. The radio is switched off: `radio-off`.
3. The device is on a profile other than the hotspot, connected: `on-network` (and that profile's failures are
   forgotten). Joining or leaving it (or the hotspot starting): `busy`.
4. There is no hotspot profile: exit 1.
5. The device is not on the hotspot: when the hotspot starts by itself, start it (`hotspot-started`; exit 1 if that
   fails), otherwise leave the radio alone (`hotspot-off`).
6. A phone is joined to the hotspot: `phone-joined`. Nothing else is run, so no scan interrupts it. If the list of
   phones can't be read, the same applies: `stations-unknown`.
7. The saved networks are the Wi-Fi client profiles that start by themselves, in order of priority, then of last use.
   Those that failed lately wait 5, then 15, then 60 minutes after each failure. None left: `nothing-to-try`, without
   a scan.
8. One scan. The first saved network that was heard, or is hidden, is the one to join; none: `nothing-in-range`. The
   scan failed: `scan-failed`.
9. Join that one network (`joined`). If it fails, it waits its turn and the hotspot is brought back (`join-failed`).
   At most one network is tried per run.
The state file holds each failing network's name, failures, and time of the last one, and the last run. It is written
under a temporary name and renamed, mode 0644; one that can't be read or makes no sense is treated as empty.

Standard library only, and no tm_control imports: this runs from the root-owned copy in
/usr/local/libexec/traffic-monitor/. Tests set NMCLI, IW, TM_SYS_NET, TM_NOW (the time), and TM_HOTSPOT_WAIT, which
are ignored when running as root.
"""

import datetime
import json
import os
import re
import subprocess
import sys
import time

NMCLI = "/usr/bin/nmcli"
IW = "/usr/sbin/iw"
SYS_NET = "/sys/class/net"
STATE_FILE = "/run/traffic-monitor/network-retry.json"
BACKOFF = (300, 900, 3600)  # seconds to wait after the first, the second, and every later failure of a network
JOIN_WAIT = 45  # nmcli --wait for a join; a wrong password takes about 25 s to fail
HOTSPOT_WAIT = 30  # nmcli --wait for the hotspot
RETURN_WAIT = 15  # how long NetworkManager gets to bring the hotspot back by itself after a failed join
WIFI = "802-11-wireless"


class Refused(Exception):
    """The run can't go on. The message says why."""


def trusted(name, default):
    """The setting `name` from the environment, but only when not root: root always uses the installed values."""
    return default if os.geteuid() == 0 else os.environ.get(name) or default


def split_terse(line):
    """The unescaped fields of one nmcli -t line, split at the colons that aren't escaped."""
    fields, current, escaped = [], [], False
    for char in line:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            fields.append("".join(current))
            current = []
        else:
            current.append(char)
    fields.append("".join(current))
    return fields


def unescape(value):
    """A value as nmcli -g prints it: a backslash escapes the character after it (`:` and `\\`)."""
    out, escaped = [], False
    for char in value:
        if char == "\\" and not escaped:
            escaped = True
        else:
            out.append(char)
            escaped = False
    return "".join(out)


def due(entry, now):
    """Whether a network may be tried again: it has no failure on record, or the wait since the last one is over."""
    if not entry:
        return True
    elapsed = now - entry["last_failure"]
    return elapsed < 0 or elapsed >= BACKOFF[min(max(entry["failures"], 1), len(BACKOFF)) - 1]  # a clock set back


def run_command(argv, timeout=60):
    """(exit status, stdout, first line of stderr). A command that outlives timeout is status -1."""
    try:
        result = subprocess.run(
            argv, capture_output=True, stdin=subprocess.DEVNULL, timeout=timeout, check=False,
            env={**os.environ, "LC_ALL": "C.UTF-8"},  # yes and no, not a translation
        )
    except subprocess.TimeoutExpired:
        return -1, "", "timed out"
    except OSError as error:
        raise Refused(f"{os.path.basename(argv[0])} could not run ({type(error).__name__})") from None
    lines = result.stderr.decode("utf-8", errors="replace").strip().splitlines()
    return result.returncode, result.stdout.decode("utf-8", errors="replace"), lines[0] if lines else ""


class Nmcli:
    def __init__(self, binary):
        self.binary = binary

    def call(self, *args, timeout=60):
        return run_command([self.binary, *args], timeout)

    def out(self, *args):
        status, out, error = self.call(*args)
        if status != 0:
            raise Refused(f"nmcli failed with exit status {status}" + (f": {error}" if error else ""))
        return out

    def device(self, device):
        """(state number, name of the profile or None) for the device."""
        values = {}
        for line in self.out("-t", "-f", "GENERAL.STATE,GENERAL.CONNECTION", "device", "show", device).splitlines():
            key, value = split_terse(line)[:2] if ":" in line else (line, "")
            values[key] = value
        state = re.match(r"\d+", values.get("GENERAL.STATE", ""))
        connection = values.get("GENERAL.CONNECTION", "")
        return int(state.group()) if state else 0, None if connection in ("", "--") else connection

    def profiles(self):
        """Every profile: name, uuid, type, autoconnect (bool), timestamp (int)."""
        found = []
        for line in self.out("-t", "-f", "NAME,UUID,TYPE,AUTOCONNECT,TIMESTAMP", "connection", "show").splitlines():
            fields = split_terse(line)
            if len(fields) != 5:
                raise Refused("nmcli listed a profile in a form this script doesn't know")
            name, uuid, kind, autoconnect, timestamp = fields
            found.append({"name": name, "uuid": uuid, "type": kind, "autoconnect": autoconnect == "yes",
                          "timestamp": int(timestamp) if timestamp.isdigit() else 0})
        return found

    def details(self, uuid):
        """(mode, hidden, priority, ssid) of a Wi-Fi profile."""
        keys = f"{WIFI}.mode,{WIFI}.hidden,connection.autoconnect-priority,{WIFI}.ssid"
        lines = self.out("-g", keys, "connection", "show", "uuid", uuid).split("\n")
        mode, hidden, priority, ssid = (unescape(lines[i]) if i < len(lines) else "" for i in range(4))
        return mode, hidden == "yes", int(priority) if re.fullmatch(r"-?\d+", priority) else 0, ssid


def read_state(path):
    """The failures on record, as {uuid: {"name", "failures", "last_failure"}}; anything unusable counts as none."""
    try:
        with open(path, encoding="utf-8") as file:
            networks = json.load(file)["networks"]
        return {
            uuid: {"name": str(entry["name"]), "failures": entry["failures"], "last_failure": float(entry["last_failure"])}
            for uuid, entry in networks.items()
            if isinstance(entry["failures"], int) and not isinstance(entry["failures"], bool) and entry["failures"] >= 1
        }
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return {}


def write_state(path, networks, now, outcome):
    """Write the state under a temporary name and rename it. A failure to write only loses the memory of failures."""
    at = datetime.datetime.fromtimestamp(now, datetime.timezone.utc).isoformat()
    document = {"networks": networks, "last_run": {"at": at, "outcome": outcome}}
    directory, name = os.path.split(path)
    temporary = os.path.join(directory or ".", f".{name}.{os.getpid()}.tmp")
    try:
        os.makedirs(directory or ".", mode=0o755, exist_ok=True)
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
        with os.fdopen(fd, "w", encoding="utf-8") as file:
            os.fchmod(file.fileno(), 0o644)
            json.dump(document, file)
        os.rename(temporary, path)
    except OSError:
        try:
            os.unlink(temporary)
        except OSError:
            pass


def radio_kind(device):
    """no-radio, usb-radio, or None when the device is a Wi-Fi radio that is part of the unit."""
    base = os.path.join(trusted("TM_SYS_NET", SYS_NET), device)
    if not os.path.isdir(os.path.join(base, "wireless")):
        return "no-radio"
    if os.path.realpath(os.path.join(base, "device", "subsystem")).endswith("/usb"):
        return "usb-radio"
    return None


def heard_networks(iw, device):
    """The names in one scan, or None when the scan failed. A hidden network is an empty name."""
    status, out, _ = run_command([iw, "dev", device, "scan"], timeout=60)
    if status != 0:
        return None
    names = set()
    for line in out.splitlines():
        if line.strip().startswith("SSID: "):
            raw = line.strip()[len("SSID: "):]
            # iw writes bytes it can't print as \xNN
            raw = re.sub(r"\\x([0-9a-fA-F]{2})", lambda m: chr(int(m.group(1), 16)), raw)
            try:
                raw = raw.encode("latin-1").decode("utf-8")
            except UnicodeError:
                pass
            names.add(raw)
    return names


def settings():
    return {
        "device": os.environ.get("TM_WIFI_DEVICE") or "wlan0",
        "hotspot": os.environ.get("TM_HOTSPOT_PROFILE") or "tm-hotspot",
        "state": os.environ.get("TM_NETWORK_STATE") or STATE_FILE,
    }


def start_hotspot(nm, hotspot):
    status, _, error = nm.call("--wait", str(HOTSPOT_WAIT), "connection", "up", hotspot, timeout=HOTSPOT_WAIT + 30)
    if status != 0:
        raise Refused(f"the hotspot could not be started (nmcli exit status {status})" + (f": {error}" if error else ""))


def attempt(nm, device, hotspot, network, networks, now):
    """Join `network`; on failure remember it and bring the hotspot back."""
    status, _, _ = nm.call("--wait", str(JOIN_WAIT), "connection", "up", "uuid", network["uuid"], timeout=JOIN_WAIT + 45)
    if status == 0:
        networks.pop(network["uuid"], None)
        return "joined"
    count = networks.get(network["uuid"], {}).get("failures", 0) + 1
    networks[network["uuid"]] = {"name": network["name"], "failures": count, "last_failure": now}
    wait = float(trusted("TM_HOTSPOT_WAIT", str(RETURN_WAIT)))
    deadline = time.monotonic() + wait
    while True:
        if nm.device(device)[1] == hotspot:
            break
        if time.monotonic() >= deadline:
            start_hotspot(nm, hotspot)
            break
        time.sleep(1)
    return "join-failed"


def decide(nm, iw, config, now, networks):
    """Steps 1 to 9. Returns the outcome; `networks` is edited in place."""
    device, hotspot = config["device"], config["hotspot"]
    kind = radio_kind(device)
    if kind:
        return kind
    if nm.out("radio", "wifi").strip() != "enabled":
        return "radio-off"
    state, connection = nm.device(device)
    if connection and connection != hotspot:
        if state == 100:
            for uuid in [u for u, entry in networks.items() if entry["name"] == connection]:
                del networks[uuid]
            return "on-network"
        if 40 <= state <= 90:
            return "busy"
    profiles = nm.profiles()
    ap = next((p for p in profiles if p["name"] == hotspot and p["type"] == WIFI), None)
    if ap is None:
        raise Refused("no hotspot profile; run the installer")
    if connection != hotspot:
        if not ap["autoconnect"]:
            return "hotspot-off"
        start_hotspot(nm, hotspot)
        return "hotspot-started"
    if 40 <= state <= 90:
        return "busy"

    status, out, _ = run_command([iw, "dev", device, "station", "dump"])
    if status != 0:
        return "stations-unknown"
    if any(line.startswith("Station ") for line in out.splitlines()):
        return "phone-joined"

    saved = []
    for profile in profiles:
        if profile["type"] != WIFI or not profile["autoconnect"] or profile["name"] == hotspot:
            continue
        mode, hidden, priority, ssid = nm.details(profile["uuid"])
        if mode == "infrastructure":
            saved.append({**profile, "hidden": hidden, "priority": priority, "ssid": ssid or profile["name"]})
    for uuid in [u for u in networks if u not in {p["uuid"] for p in saved}]:
        del networks[uuid]  # no longer saved
    saved.sort(key=lambda p: (-p["priority"], -p["timestamp"]))
    saved = [p for p in saved if due(networks.get(p["uuid"]), now)]
    if not saved:
        return "nothing-to-try"
    heard = heard_networks(iw, device)
    if heard is None:
        return "scan-failed"
    candidate = next((p for p in saved if p["ssid"] in heard or p["hidden"]), None)
    if candidate is None:
        return "nothing-in-range"
    return attempt(nm, device, hotspot, candidate, networks, now)


def run(now):
    """One run of the timer; returns the outcome. Raises Refused when it must exit 1."""
    config = settings()
    networks = read_state(config["state"])
    try:
        outcome = decide(Nmcli(trusted("NMCLI", NMCLI)), trusted("IW", IW), config, now, networks)
    except Refused:
        write_state(config["state"], networks, now, "error")
        raise
    write_state(config["state"], networks, now, outcome)
    return outcome


def main():
    try:
        stated = trusted("TM_NOW", "")
        print(run(float(stated) if stated else time.time()))
    except Refused as error:
        print(f"refused: {error}", file=sys.stderr)
        return 1
    except Exception as error:  # print only the kind of error, as the other root scripts do
        print(f"failed: {type(error).__name__}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
