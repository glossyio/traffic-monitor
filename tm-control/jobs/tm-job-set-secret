#!/usr/bin/python3
"""Write an entered secret (a token or key an operator typed into tm-control), its env lines, and restart its apps.

tm-job-set-secret.service runs this as root (`python -EP`), after tm-control writes the request
/run/tm-control/jobs/set-secret.json: {"name": ..., "value": ...}. tm-control runs unprivileged as the manifest's code
owner, who owns /run/tm-control and the code directory, so the request and everything under the code directory are
treated as hostile:
- the jobs directory is opened without following a symlink and must belong to the code owner and be writable by no
  one else; the request is opened and deleted relative to it, so its path can't be swapped mid-way;
- the request must be a small regular file of the code owner's with one link, holding exactly the string keys name
  and value;
- the name must be one of SECRETS below, the only list of what this job may write, and the value must be empty (which
  removes the secret) or match the secret's pattern as a whole. The patterns leave out every character an env line,
  a header, or (for the ThingsBoard token) a URL path can't carry: spaces, quotes, line breaks, NULs, non-ASCII;
- the secrets directory is opened without following a symlink and must belong to root and be writable by no one
  else. The secret is written to a new file in it (O_EXCL, 0640, root and the directory's group) and renamed over the
  secret's own;
- the code directory must be the code owner's (it may be a link: its parent is root's), and each env file is reached
  from it one directory at a time without following a symlink, and must be a regular file with one link. Its new
  text goes to a new file beside it (O_EXCL) that takes the original's mode, owner, and group before it is renamed
  over it, so nothing is ever written through a name the code owner chose. Every KEY= line of the secret's key gets
  the value, since podman's env file takes the last of duplicate keys.
Every env file is checked before anything is written. Then the secret is written, then the env lines, then the units
restart, so a step that fails leaves the device no worse than before it, and the output says which step that was.

The value is never printed: refusals name the rule, not the value, and an unexpected error prints only its kind. The
request is deleted whatever happens, unless the jobs directory itself can't be trusted: when the manifest can't be
read (so the code owner who must own the directory is unknown), or the directory fails its owner and mode checks, the
request is left where it is, and tm-control clears a request no job is waiting for.

Standard library only, and no tm_control imports: this runs from the root-owned copy in
/usr/local/libexec/traffic-monitor/. Its SECRETS table repeats tm-control's (a test keeps the two the same). Tests
pass the request path as argv[1] and set TM_CONTROL_MANIFEST, TM_CONTROL_SECRETS_DIR, and SYSTEMCTL, which is ignored
when running as root. Run as anyone but root (tests only), the secrets directory may be that user's instead of root's.
"""

import json
import os
import pwd
import re
import stat
import subprocess
import sys

REQUEST = "/run/tm-control/jobs/set-secret.json"
MANIFEST = "/etc/traffic-monitor/manifest.json"
SECRETS_DIR = "/etc/traffic-monitor/secrets"
SYSTEMCTL = "/usr/bin/systemctl"
MAX_REQUEST = 4096  # bytes
MAX_ENV_FILE = 1024 * 1024  # bytes; tmsetup's env files are a few hundred
RESTART_TIMEOUT = 120  # seconds per unit

# Each entered secret: the value's pattern, the env lines that carry it (file relative to the manifest's codedir,
# key), and the units that read those files, in the order they restart.
SECRETS = {
    "thingsboard_access_token": {
        "pattern": r"[A-Za-z0-9._~-]{1,256}",  # goes into a URL path
        "env": [("node-red-tm/node-red-tm.env", "TM_THINGSBOARD_ACCESS_TOKEN")],
        "restart": ["node-red-tm.service"],
    },
    "frigate_plus_api_key": {
        "pattern": r"[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}:[a-z0-9]{40}",  # Frigate's own
        "env": [("frigate/frigate.env", "PLUS_API_KEY")],
        "restart": ["frigate.service"],
    },
    "plate_recognizer_token": {
        "pattern": r"[\x21-\x7e]{1,256}",  # a header value and an env line
        "env": [
            ("plate-recognizer/plate-recognizer.env", "TOKEN"),
            ("node-red-tm/node-red-tm.env", "TM_PLATE_RECOGNIZER_TOKEN"),
        ],
        "restart": ["plate-recognizer.service", "node-red-tm.service"],
    },
    "plate_recognizer_license_key": {
        "pattern": r"[\x21-\x7e]{1,256}",
        "env": [("plate-recognizer/plate-recognizer.env", "LICENSE_KEY")],
        "restart": ["plate-recognizer.service"],
    },
}


class Refused(Exception):
    """The request can't be carried out. The message says why and never holds the value."""


def read_manifest(path):
    """The code directory and the code owner's uid, from the install manifest."""
    try:
        with open(path, "rb") as file:
            manifest = json.load(file)
    except (OSError, ValueError):
        raise Refused(f"the manifest {path} can't be read") from None
    if not isinstance(manifest, dict):
        raise Refused(f"the manifest {path} is not a JSON object")
    codedir, owner = manifest.get("codedir"), manifest.get("codeowner")
    if not isinstance(codedir, str) or not os.path.isabs(codedir) or "\x00" in codedir:
        raise Refused(f"the manifest {path} names no valid code directory")
    try:
        owner_uid = pwd.getpwnam(owner).pw_uid
    except (KeyError, TypeError):
        raise Refused(f"the manifest {path} names no code owner that exists here") from None
    return codedir, owner_uid


def open_jobs_dir(path, owner_uid):
    """A descriptor for the jobs directory, which must be the code owner's and writable by no one else."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f"the jobs directory can't be opened ({error.strerror})") from None
    info = os.fstat(fd)
    if info.st_uid != owner_uid or info.st_mode & 0o022:
        os.close(fd)
        raise Refused("the jobs directory is not tm-control's own")
    return fd


def read_request(dir_fd, name, owner_uid):
    """The request's JSON object, read without following a symlink and only from a small regular file."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
    except FileNotFoundError:
        raise Refused("there is no request") from None
    except OSError as error:
        raise Refused(f"the request can't be opened ({error.strerror})") from None
    with os.fdopen(fd, "rb") as file:
        info = os.fstat(file.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != owner_uid:
            raise Refused("the request is not a plain file of tm-control's")
        data = file.read(MAX_REQUEST + 1)
    if len(data) > MAX_REQUEST:
        raise Refused(f"the request is larger than {MAX_REQUEST} bytes")
    try:
        request = json.loads(data)
    except ValueError:
        raise Refused("the request is not JSON") from None
    if not isinstance(request, dict):
        raise Refused("the request is not a JSON object")
    return request


def check(request):
    """The name and value from a request that passes every rule. Neither is quoted in a refusal."""
    if set(request) != {"name", "value"}:
        raise Refused("the request must have exactly the keys name and value")
    name, value = request["name"], request["value"]
    if not isinstance(name, str) or not isinstance(value, str):
        raise Refused("the name and value must be strings")
    if name not in SECRETS:
        raise Refused(f"the name is not one of the entered secrets ({', '.join(SECRETS)})")
    pattern = SECRETS[name]["pattern"]
    if value and not re.fullmatch(pattern, value):
        raise Refused(f"the value of {name} must be empty or match {pattern}")
    return name, value


def open_secrets_dir(path):
    """A descriptor for the secrets directory: root's (as root) and writable by no one else."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f"the secrets directory can't be opened ({error.strerror})") from None
    info = os.fstat(fd)
    owner = 0 if os.geteuid() == 0 else os.getuid()  # tests run as themselves; on a device this is always root
    if info.st_uid != owner or info.st_mode & 0o022:
        os.close(fd)
        raise Refused("the secrets directory is not root's alone")
    return fd


def open_env_file(codedir, owner_uid, relpath):
    """(directory descriptor, file name, descriptor) for an env file, reached without following any symlink below
    the code directory, and only if it is a regular file with one link. The caller closes both descriptors.

    The code directory itself may be a link (to other storage, say): its parent is root's, so only root can change
    where it points. What it leads to must be the code owner's.
    """
    *parts, filename = relpath.split("/")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    try:
        dir_fd = os.open(codedir, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f"the code directory can't be opened ({error.strerror})") from None
    try:
        if os.fstat(dir_fd).st_uid != owner_uid:
            raise Refused("the code directory isn't the code owner's")
        for part in parts:
            try:
                next_fd = os.open(part, flags, dir_fd=dir_fd)
            except FileNotFoundError:
                raise Refused(f"{filename} is missing; the add-on isn't installed") from None
            except OSError as error:
                raise Refused(f"the directory of {filename} can't be opened ({error.strerror})") from None
            os.close(dir_fd)
            dir_fd = next_fd
        try:
            fd = os.open(filename, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
        except FileNotFoundError:
            raise Refused(f"{filename} is missing; the add-on isn't installed") from None
        except OSError as error:
            raise Refused(f"{filename} can't be opened ({error.strerror})") from None
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            os.close(fd)
            raise Refused(f"{filename} is not a plain file")
        return dir_fd, filename, fd
    except BaseException:
        os.close(dir_fd)
        raise


def check_env_files(codedir, owner_uid, entries):
    """Refuse before anything is written unless every env file of the secret is there and a plain file."""
    for relpath, _key in entries:
        dir_fd, _filename, fd = open_env_file(codedir, owner_uid, relpath)
        os.close(fd)
        os.close(dir_fd)


def _temporary(dir_fd, name, mode):
    """A new file beside name in dir_fd, created O_EXCL so nothing that was there is ever opened."""
    for attempt in range(100):
        temporary = f".{name}.{os.getpid()}.{attempt}.tmp"
        try:
            fd = os.open(
                temporary,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                mode,
                dir_fd=dir_fd,
            )
        except FileExistsError:
            continue
        return temporary, fd
    raise FileExistsError("no free temporary name")


def _replace(dir_fd, name, data, mode, uid, gid):
    """Write data to a temporary file in dir_fd with mode, uid, and gid, then rename it over name."""
    temporary, fd = _temporary(dir_fd, name, 0o600)
    try:
        with os.fdopen(fd, "wb") as file:
            file.write(data)
            file.flush()
            os.fchmod(file.fileno(), mode)
            if uid is not None:
                os.fchown(file.fileno(), uid, gid)
            os.fsync(file.fileno())
        os.replace(temporary, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        try:
            os.unlink(temporary, dir_fd=dir_fd)
        except OSError:
            pass
        raise
    os.fsync(dir_fd)


def write_secret(dir_fd, name, value):
    """The secret's file: the value and a newline, or empty to remove it; 0640, root and the directory's group."""
    owner = (0, os.fstat(dir_fd).st_gid) if os.geteuid() == 0 else (None, None)
    _replace(dir_fd, name, f"{value}\n".encode() if value else b"", 0o640, *owner)


def set_env_line(codedir, owner_uid, relpath, key, value):
    """Replace every KEY= line of the env file where it stands, or append one; every other byte stays as it was.

    Every one, not the first: podman's env file takes the last of duplicate keys.
    """
    dir_fd, filename, fd = open_env_file(codedir, owner_uid, relpath)
    try:
        with os.fdopen(fd, "rb") as file:
            info = os.fstat(file.fileno())
            data = file.read(MAX_ENV_FILE + 1)
        if len(data) > MAX_ENV_FILE:
            raise Refused(f"{filename} is larger than {MAX_ENV_FILE} bytes")
        line = f"{key}={value}".encode()
        # A function, not a replacement string, so a backslash in the value stays a backslash
        data, count = re.subn(rb"^" + re.escape(key.encode()) + rb"=[^\r\n]*", lambda _: line, data, flags=re.MULTILINE)
        if not count:
            data += (b"\n" if data and not data.endswith(b"\n") else b"") + line + b"\n"
        _replace(dir_fd, filename, data, stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid)
    finally:
        os.close(dir_fd)
    return filename


def systemctl_binary():
    """systemctl, or a stand-in from SYSTEMCTL for tests; root always runs the real one."""
    if os.geteuid() == 0:
        return SYSTEMCTL
    return os.environ.get("SYSTEMCTL") or SYSTEMCTL


def restart(units):
    """Restart each unit, the rest too when one fails. The names of the units that failed."""
    failed = []
    for unit in units:
        try:
            result = subprocess.run(
                [systemctl_binary(), "restart", unit],
                stdin=subprocess.DEVNULL,
                capture_output=True,
                timeout=RESTART_TIMEOUT,
                check=False,
            )
        except subprocess.TimeoutExpired:
            print(f"failed: restart of {unit} timed out after {RESTART_TIMEOUT} s; the secret is written")
            failed.append(unit)
            continue
        except OSError as error:
            print(f"failed: restart of {unit} could not run ({type(error).__name__}); the secret is written")
            failed.append(unit)
            continue
        for line in (result.stdout + result.stderr).decode("utf-8", errors="replace").splitlines():
            print(f"systemctl: {line}")
        if result.returncode != 0:
            print(f"failed: restart of {unit} exited {result.returncode}; the secret is written")
            failed.append(unit)
        else:
            print(f"restarted {unit}")
    return failed


def delete_request(dir_fd, name):
    try:
        os.unlink(name, dir_fd=dir_fd)
    except FileNotFoundError:
        pass
    except OSError as error:
        print(f"the request could not be deleted ({error.strerror})")


def main(argv):
    directory, request_name = os.path.split(argv[1] if len(argv) > 1 else REQUEST)
    jobs_fd = secrets_fd = None
    step = "checking the request"
    written = False
    try:
        codedir, owner_uid = read_manifest(os.environ.get("TM_CONTROL_MANIFEST") or MANIFEST)
        jobs_fd = open_jobs_dir(directory or ".", owner_uid)
        name, value = check(read_request(jobs_fd, request_name, owner_uid))
        secret = SECRETS[name]
        secrets_fd = open_secrets_dir(os.environ.get("TM_CONTROL_SECRETS_DIR") or SECRETS_DIR)
        check_env_files(codedir, owner_uid, secret["env"])
        step = "writing the secret"
        write_secret(secrets_fd, name, value)
        written = True
        print(f"set secret {name}" if value else f"removed secret {name}")
        for relpath, key in secret["env"]:
            step = f"updating {os.path.basename(relpath)}"
            print(f"updated {set_env_line(codedir, owner_uid, relpath, key, value)}")
        step = "restarting"
        if restart(secret["restart"]):
            return 1
    except Refused as error:
        print(f"refused: {error}" + ("; the secret is written" if written else ""))
        return 1
    except Exception as error:  # a message could quote the request, so print only the kind of error
        print(f"failed: {step} ({type(error).__name__})" + ("; the secret is written" if written else ""))
        return 1
    finally:
        if secrets_fd is not None:
            os.close(secrets_fd)
        if jobs_fd is not None:
            delete_request(jobs_fd, request_name)
            os.close(jobs_fd)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
