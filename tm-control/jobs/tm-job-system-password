#!/usr/bin/python3
"""Set the Linux password of the user who installed Traffic Monitor, as tm-control's admin asked.

tm-job-system-password.service runs this as root (`python -EP`), after tm-control writes the request
/run/tm-control/jobs/system-password.json: {"username": ..., "password": ...}. tm-control runs unprivileged, so the
request is treated as hostile: no symlinks, a small regular file, exactly those two string keys, the username must be
the manifest's installing_user, and the password 10 to 256 characters with no line breaks. The password goes to
chpasswd on stdin and is never printed. The request is deleted whatever happens.

Standard library only, and no tm_control imports: this runs from the root-owned copy in
/usr/local/libexec/traffic-monitor/. Tests pass the request path as argv[1] and set CHPASSWD and TM_CONTROL_MANIFEST.
"""

import json
import os
import stat
import subprocess
import sys

REQUEST = "/run/tm-control/jobs/system-password.json"
MANIFEST = "/etc/traffic-monitor/manifest.json"
CHPASSWD = "/usr/sbin/chpasswd"
MAX_REQUEST = 4096  # bytes
PASSWORD_MIN, PASSWORD_MAX = 10, 256  # as tm-control's own password rules


class Refused(Exception):
    """The request can't be carried out. The message says why and never holds the password."""


def read_request(path):
    """The request's JSON object, read without following a symlink and only from a small regular file."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        raise Refused("there is no request") from None
    except OSError as error:
        raise Refused(f"the request can't be opened ({error.strerror})") from None
    with os.fdopen(fd, "rb") as file:
        info = os.fstat(file.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise Refused("the request is not a plain file")
        data = file.read(MAX_REQUEST + 1)
    if len(data) > MAX_REQUEST:
        raise Refused(f"the request is larger than {MAX_REQUEST} bytes")
    try:
        request = json.loads(data)
    except ValueError:
        raise Refused("the request is not JSON") from None
    if not isinstance(request, dict):
        raise Refused("the request is not a JSON object")
    return request


def installing_user(path):
    try:
        with open(path, "rb") as file:
            user = json.load(file).get("installing_user")
    except (OSError, ValueError, AttributeError):
        raise Refused(f"the manifest {path} can't be read") from None
    if not isinstance(user, str) or not user:
        raise Refused(f"the manifest {path} names no installing user")
    return user


def check(request, user):
    """The username and password from a request that passes every rule."""
    if set(request) != {"username", "password"}:
        raise Refused("the request must have exactly the keys username and password")
    username, password = request["username"], request["password"]
    if not isinstance(username, str) or not isinstance(password, str):
        raise Refused("the username and password must be strings")
    if username != user:
        raise Refused("only the password of the user who installed Traffic Monitor can be set")
    if not PASSWORD_MIN <= len(password) <= PASSWORD_MAX:
        raise Refused(f"the password must be {PASSWORD_MIN} to {PASSWORD_MAX} characters")
    if any(char in password for char in "\n\r\x00"):
        raise Refused("the password can't contain line breaks")
    return username, password


def set_password(username, password):
    chpasswd = os.environ.get("CHPASSWD") or CHPASSWD
    try:
        result = subprocess.run(
            [chpasswd], input=f"{username}:{password}\n".encode(), capture_output=True, timeout=60, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Refused(f"chpasswd could not run ({type(error).__name__})") from None
    # chpasswd doesn't echo its input, but its messages pass through here, so make sure of it.
    messages = (result.stdout + result.stderr).decode("utf-8", errors="replace").replace(password, "[hidden]")
    for line in messages.splitlines():
        print(f"chpasswd: {line}")
    if result.returncode != 0:
        raise Refused(f"chpasswd failed with exit status {result.returncode}")


def main(argv):
    path = argv[1] if len(argv) > 1 else REQUEST
    try:
        request = read_request(path)
        username, password = check(request, installing_user(os.environ.get("TM_CONTROL_MANIFEST") or MANIFEST))
        set_password(username, password)
    except Refused as error:
        print(f"refused: {error}")
        return 1
    except Exception as error:  # a message could quote the request, so print only the kind of error
        print(f"failed: {type(error).__name__}")
        return 1
    finally:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        except OSError as error:
            print(f"the request could not be deleted ({error.strerror})")
    print(f"password set for {username}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
