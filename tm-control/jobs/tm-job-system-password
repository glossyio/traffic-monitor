#!/usr/bin/python3
"""Set the Linux password of the user who installed Traffic Monitor, as tm-control's admin asked.

tm-job-system-password.service runs this as root (`python -EP`), after tm-control writes the request
/run/tm-control/jobs/system-password.json: {"username": ..., "password": ...}. tm-control runs unprivileged as the
manifest's code owner, who owns /run/tm-control, so the request is treated as hostile:
- the jobs directory is opened without following a symlink and must belong to the code owner and be writable by no
  one else; the request is opened and deleted relative to it, so its path can't be swapped mid-way;
- the request must be a small regular file of the code owner's with one link, holding exactly the string keys
  username and password;
- the username must be the manifest's installing_user, which must be a plain POSIX username of an account that exists
  here and isn't uid 0: root's password is never set this way (tmsetup.sh refuses to run as root, and this backs it up);
- the password must be 10 to 256 characters, encodable as UTF-8, with no line breaks or NULs.
The password goes to chpasswd on stdin and is never printed. The request is deleted whatever happens, unless the
jobs directory itself can't be trusted (tm-control clears a request no job is waiting for).

Standard library only, and no tm_control imports: this runs from the root-owned copy in
/usr/local/libexec/traffic-monitor/. Tests pass the request path as argv[1] and set TM_CONTROL_MANIFEST, and CHPASSWD,
which is ignored when running as root.
"""

import json
import os
import pwd
import re
import stat
import subprocess
import sys

REQUEST = "/run/tm-control/jobs/system-password.json"
MANIFEST = "/etc/traffic-monitor/manifest.json"
CHPASSWD = "/usr/sbin/chpasswd"
MAX_REQUEST = 4096  # bytes
PASSWORD_MIN, PASSWORD_MAX = 10, 256  # as tm-control's own password rules
USERNAME = re.compile(r"[a-z_][a-z0-9_-]{0,31}")


class Refused(Exception):
    """The request can't be carried out. The message says why and never holds the password."""


def read_manifest(path):
    """The installing user's name and the code owner's uid, from the install manifest."""
    try:
        with open(path, "rb") as file:
            manifest = json.load(file)
    except (OSError, ValueError):
        raise Refused(f"the manifest {path} can't be read") from None
    if not isinstance(manifest, dict):
        raise Refused(f"the manifest {path} is not a JSON object")
    user, owner = manifest.get("installing_user"), manifest.get("codeowner")
    if not isinstance(user, str) or not USERNAME.fullmatch(user):
        raise Refused(f"the manifest {path} names no valid installing user")
    try:
        owner_uid = pwd.getpwnam(owner).pw_uid
    except (KeyError, TypeError):
        raise Refused(f"the manifest {path} names no code owner that exists here") from None
    return user, owner_uid


def open_jobs_dir(path, owner_uid):
    """A descriptor for the jobs directory, which must be the code owner's and writable by no one else."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f"the jobs directory can't be opened ({error.strerror})") from None
    info = os.fstat(fd)
    if info.st_uid != owner_uid or info.st_mode & 0o022:
        os.close(fd)
        raise Refused("the jobs directory is not tm-control's own")
    return fd


def read_request(dir_fd, name, owner_uid):
    """The request's JSON object, read without following a symlink and only from a small regular file."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
    except FileNotFoundError:
        raise Refused("there is no request") from None
    except OSError as error:
        raise Refused(f"the request can't be opened ({error.strerror})") from None
    with os.fdopen(fd, "rb") as file:
        info = os.fstat(file.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != owner_uid:
            raise Refused("the request is not a plain file of tm-control's")
        data = file.read(MAX_REQUEST + 1)
    if len(data) > MAX_REQUEST:
        raise Refused(f"the request is larger than {MAX_REQUEST} bytes")
    try:
        request = json.loads(data)
    except ValueError:
        raise Refused("the request is not JSON") from None
    if not isinstance(request, dict):
        raise Refused("the request is not a JSON object")
    return request


def check(request, user):
    """The username and password from a request that passes every rule."""
    if set(request) != {"username", "password"}:
        raise Refused("the request must have exactly the keys username and password")
    username, password = request["username"], request["password"]
    if not isinstance(username, str) or not isinstance(password, str):
        raise Refused("the username and password must be strings")
    if username != user:
        raise Refused("only the password of the user who installed Traffic Monitor can be set")
    if not PASSWORD_MIN <= len(password) <= PASSWORD_MAX:
        raise Refused(f"the password must be {PASSWORD_MIN} to {PASSWORD_MAX} characters")
    if any(char in password for char in "\n\r\x00"):
        raise Refused("the password can't contain line breaks")
    try:
        password.encode("utf-8")
    except UnicodeEncodeError:
        raise Refused("the password is not valid text") from None
    return username, password


def check_account(username):
    """Refuse an account that doesn't exist here, or that is root under any name (uid 0)."""
    try:
        uid = pwd.getpwnam(username).pw_uid
    except KeyError:
        raise Refused(f"there is no account {username} on this device") from None
    if uid == 0:
        raise Refused(f"{username} is a root account (uid 0), and root's password is never set from tm-control")


def chpasswd_binary():
    """chpasswd, or a stand-in from CHPASSWD for tests; root always runs the real one."""
    if os.geteuid() == 0:
        return CHPASSWD
    return os.environ.get("CHPASSWD") or CHPASSWD


def set_password(username, password):
    try:
        result = subprocess.run(
            [chpasswd_binary()],
            input=f"{username}:{password}\n".encode(),
            capture_output=True,
            timeout=60,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Refused(f"chpasswd could not run ({type(error).__name__})") from None
    # chpasswd doesn't echo its input, but its messages pass through here, so make sure of it.
    messages = (result.stdout + result.stderr).decode("utf-8", errors="replace").replace(password, "[hidden]")
    for line in messages.splitlines():
        print(f"chpasswd: {line}")
    if result.returncode != 0:
        raise Refused(f"chpasswd failed with exit status {result.returncode}")


def delete_request(dir_fd, name):
    try:
        os.unlink(name, dir_fd=dir_fd)
    except FileNotFoundError:
        pass
    except OSError as error:
        print(f"the request could not be deleted ({error.strerror})")


def main(argv):
    directory, name = os.path.split(argv[1] if len(argv) > 1 else REQUEST)
    dir_fd = None
    try:
        user, owner_uid = read_manifest(os.environ.get("TM_CONTROL_MANIFEST") or MANIFEST)
        dir_fd = open_jobs_dir(directory or ".", owner_uid)
        username, password = check(read_request(dir_fd, name, owner_uid), user)
        check_account(username)
        set_password(username, password)
    except Refused as error:
        print(f"refused: {error}")
        return 1
    except Exception as error:  # a message could quote the request, so print only the kind of error
        print(f"failed: {type(error).__name__}")
        return 1
    finally:
        if dir_fd is not None:
            delete_request(dir_fd, name)
            os.close(dir_fd)
    print(f"password set for {username}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
