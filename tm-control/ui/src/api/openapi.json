              "rescan",
              "link",
              "hint"
            ],
            "title": "Kind"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "href": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Href"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "text"
        ],
        "title": "Fix",
        "description": "What the UI offers for a check that isn't ok: restart a unit, check again, open a page, or a hint to read."
      },
      "Group": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "checks": {
